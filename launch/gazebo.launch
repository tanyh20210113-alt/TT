<launch>
  <include file="$(find gazebo_ros)/launch/empty_world.launch"/>
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find ma360_urdf_ros1)/urdf/ma360.urdf"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_ma360" args="-urdf -param robot_description -model ma360 -z 0.09"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
</launch>
